# Copy to .env and fill in. Everything is optional; missing keys fall back gracefully.
ORG_NAME=Acme Pvt Ltd
ORG_DOMAINS=acme.com,acme.in
TELEGRAM_BOT_TOKEN=          # from @BotFather; enables out-of-band verification + citizen bot
ANTHROPIC_API_KEY=           # enables LLM tactic tagging (lexicon used otherwise)
LLM_MODEL=claude-sonnet-5-5
GOOGLE_SAFE_BROWSING_KEY=    # enables live URL reputation
WHISPER_SIZE=large-v3        # use small on CPU-only laptops
WHISPER_LIVE_SIZE=small
VIDEO_FRAMES=32              # use 8 on CPU-only laptops
VOICE_THRESHOLD=0.40         # tune with eval/ on your enrolled voices
FACE_THRESHOLD=0.40
GEND_FAKE_INDEX=1            # confirm with eval/check_gend.py
PELLAV2_REVISION=29daea8b04acf2d3f11d1d0da6b01c17fc8a1e4b   # pellav2_infer.py read and reviewed 31 Oct 2026
# Out-of-band verification (notify.py). SMS links and QR codes need nothing; email is automatic with these set.
SMTP_USER=                   # e.g. a Gmail address; use a Gmail "app password" below, never the real password
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
PUBLIC_URL=                  # where phones reach the backend; default http://<this laptop's Wi-Fi IP>:8000 (run uvicorn --host 0.0.0.0)
LINK_LOOKUPS=1               # 0 = no short-link expansion or domain-age (RDAP) lookups, e.g. offline
